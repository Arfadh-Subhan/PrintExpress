<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8FF"
    tools:context=".HomeActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Lime Yellow Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D0FE1D"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/letterlogo"
                        android:contentDescription="Logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PrintXpress"
                        android:textColor="#171717"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="Notifications" />

            </LinearLayout>

        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Welcome Message -->
                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello! User"
                    android:textColor="#171717"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="8dp" />

                <!-- Row 1: Browse Products & My Orders -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBrowseProducts"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toStartOf="@+id/cardMyOrders"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvWelcome"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llBrowseProducts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivBrowseProducts"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_products"
                            android:contentDescription="Browse Products"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Browse Products"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View all printing products"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMyOrders"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardBrowseProducts"
                    app:layout_constraintTop_toBottomOf="@+id/tvWelcome"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llMyOrders"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivMyOrders"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_orders"
                            android:contentDescription="My Orders"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Orders"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View your order history"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Row 2: Track Order & View Gallery -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTrackOrder"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toStartOf="@+id/cardViewGallery"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardBrowseProducts"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llTrackOrder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivTrackOrder"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_track"
                            android:contentDescription="Track Order"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Track Order"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Track your order status"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewGallery"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardTrackOrder"
                    app:layout_constraintTop_toBottomOf="@+id/cardMyOrders"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llViewGallery"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivViewGallery"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_gallery"
                            android:contentDescription="View Gallery"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View Gallery"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Browse sample designs"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Row 3: Guidelines & FAQ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGuidelines"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toStartOf="@+id/cardFAQ"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardTrackOrder"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llGuidelines"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivGuidelines"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_guidelines"
                            android:contentDescription="Guidelines"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Guidelines"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Printing requirements"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFAQ"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardGuidelines"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewGallery"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llFAQ"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivFAQ"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_faq"
                            android:contentDescription="FAQ"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FAQ"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Frequently asked questions"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Row 4: View Offers & Customer Support -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewOffers"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toStartOf="@+id/cardSupport"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardGuidelines"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llViewOffers"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivViewOffers"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_offers"
                            android:contentDescription="View Offers"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View Offers"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Special discounts and deals"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSupport"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cardViewOffers"
                    app:layout_constraintTop_toBottomOf="@+id/cardFAQ"
                    app:layout_constraintWidth_default="spread">

                    <LinearLayout
                        android:id="@+id/llCustomerSupport"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivCustomerSupport"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_support"
                            android:contentDescription="Customer Support"
                            android:tint="#171717" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Support"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#171717" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Get help and assistance"
                                android:textSize="12sp"
                                android:textColor="#888888" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Sample Designs Section -->
                <TextView
                    android:id="@+id/tvSampleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sample Designs"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#171717"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardViewOffers" />

                <LinearLayout
                    android:id="@+id/layoutSamples"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvSampleTitle">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_sample1" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_sample2" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_sample3" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnViewAllSamples"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View All Sample Designs"
                    android:padding="12dp"
                    android:backgroundTint="#D0FE1D"
                    android:textColor="#171717"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/layoutSamples" />

                <!-- Logout Button -->
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:padding="14dp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/btnViewAllSamples" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Sidebar Menu -->
    <include
        android:id="@+id/drawerMenu"
        layout="@layout/sidebar_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>